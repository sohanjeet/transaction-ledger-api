# Application port (optional; defaults to 3000 in src/server.ts)
PORT=3000

# Development database started by docker compose up -d
DATABASE_URL="postgresql://ledger:ledger_dev@localhost:5432/ledger_db"

# Optional and deliberately separate database used only by PostgreSQL integration tests.
# Never point this at the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://ledger:ledger_test@localhost:5433/ledger_test"
